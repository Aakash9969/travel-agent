# Copy this file to .env and fill in your keys. Never commit .env.
#
# The agent works with Anthropic OR any OpenAI-compatible endpoint
# (NVIDIA NIM, OpenAI, local vLLM/Ollama...). Whichever keys are present
# decides the provider; set LLM_PROVIDER to force one of: anthropic, nvidia, openai.

# --- NVIDIA NIM (https://build.nvidia.com) - OpenAI-compatible, free credits ---
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3

# --- Anthropic (alternative) - https://console.anthropic.com/settings/keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Any other OpenAI-compatible endpoint (optional) ---
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4.1
#OPENAI_BASE_URL=https://api.openai.com/v1

# --- Amadeus (real flight/hotel search) - free keys at
# https://developers.amadeus.com (Self-Service APIs, TEST environment) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
